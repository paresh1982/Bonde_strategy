# Alpaca Markets API Credentials (Stage 3 Paper Trading)
# Get your free paper trading API keys at: https://app.alpaca.markets
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here

# Feed selection: 'iex' (default, free real-time feed) or 'sip' ($99/mo consolidated feed)
ALPACA_FEED=iex

# Base URLs
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_FEED_URL=wss://stream.data.alpaca.markets
